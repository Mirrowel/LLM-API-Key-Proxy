{
	"$schema": "https://opencode.ai/config.json",
	"provider": {
		"your-provider": {
			"options": {
				"apiKey": "sk-replace-with-your-provider-api-key"
			},
			"models": {
				"your-model": {
					"options": {
						"reasoningEffort": "high"
					}
				},
				"your-fast-model": {
					"options": {
						"reasoningEffort": "high"
					}
				}
			}
		}
	},
	"model": "your-provider/your-model",
	"small_model": "your-provider/your-fast-model",
	"agent": {
		"explore": {
			"model": "your-provider/your-fast-model"
		},
		"general": {
		}
	},
	"mcp": {
		"example-remote": {
			"enabled": true,
			"type": "remote",
			"url": "https://mcp.example.com/mcp",
			"headers": {
				"x-api-key": "replace-with-your-mcp-key-123456"
			}
		}
	},
	"plugin": [],
	"permission": {
		"bash": {
			"*": "allow",
			"env": "deny",
